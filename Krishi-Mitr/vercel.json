{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "http://3.227.26.8/api/v1/:path*"
    },
    {
      "source": "/video",
      "destination": "/video.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
