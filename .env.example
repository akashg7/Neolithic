# Database
DATABASE_URL=postgresql+asyncpg://agrisense:agrisense@localhost:5432/agrisense

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Razorpay (test mode)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxx

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=agrisense

# Tier 3 (stretch — leave empty until needed)
BHASHINI_API_KEY=
BHASHINI_USER_ID=
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Sarvam AI — speech-to-text proxy. Get a key at https://dashboard.sarvam.ai/
# Leave empty and POST /voice/transcribe returns 503 until a key is set.
SARVAM_API_KEY=
SARVAM_ASR_ENDPOINT=https://api.sarvam.ai/speech-to-text
SARVAM_ASR_MODEL=saaras:v3

# Sarvam AI — text-to-speech + voice tuning (same keys the frontend
# `app/src/voice/config.ts` reads; kept server-side for later /narrate).
SARVAM_TTS_ENDPOINT=https://api.sarvam.ai/text-to-speech
SARVAM_NORMALIZE_ENDPOINT=https://api.sarvam.ai/v1/chat/completions
SARVAM_TTS_SPEAKER=shubh
VOICE_CONFIDENCE_THRESHOLD=0.6
VOICE_MAX_RECORDING_SECONDS=10
VOICE_CACHE_ENABLED=true

# ---------------------------------------------------------------------------
# NLP / RAG layer (app/nlp, app/rag) — see NLP_RAG_README.md
# Defaults are offline stubs so the agent loop can be built without any keys.
# ---------------------------------------------------------------------------
# Translation: stub (fixed English + hints, offline) | sarvam (real API, needs SARVAM_API_KEY above)
TRANSLATE_BACKEND=stub
TRANSLATE_PIVOT=on
TRANSLATE_TIMEOUT_S=2.5
STT_TIMEOUT_S=6
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_TRANSLATE_MODEL=mayura:v1
SARVAM_STT_MODEL=saaras:v3
# Optional: path to write per-call Sarvam latency (feeds timing_summary())
SARVAM_TIMING_LOG=

# Retrieval: stub (fixed chunks) | real (BGE-M3 + Qdrant hybrid; needs FlagEmbedding + ~2 GB model download)
RETRIEVER=stub
RETRIEVE_MODE=hybrid
EMBEDDER=bge-m3
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=krishi_rag
RERANK=off
RERANK_MODEL=BAAI/bge-reranker-v2-m3
