# ═══════════════════════════════════════════════════════════════════════════
#  Krishi-Mitr backend — every environment variable, with what it does.
#  Copy to `.env` (git-ignored) and fill in. Nothing here goes in the app:
#  the app holds no keys, it only talks to this API.
# ═══════════════════════════════════════════════════════════════════════════

# ── Runtime ───────────────────────────────────────────────────────────────
# "production" turns OFF dev conveniences (dev_otp echo, DEV_FIXED_OTP, demo login).
# For the pitch-demo server keep "development": there is no SMS provider yet,
# so the OTP screen needs the echoed test code and the demo buttons need DEMO_MODE.
ENV=development

# ── Docker stack (docker compose up / deploy/deploy.sh) ───────────────────
# Read by docker-compose.yml. Containers get DATABASE_URL / REDIS_URL / S3_*
# built from these, so the localhost URLs below only matter outside Docker.
# Use letters and digits only in the password (it goes inside a URL).
POSTGRES_USER=agrisense
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=agrisense
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-password
# Ports nginx publishes.
HTTP_PORT=80
HTTPS_PORT=443
# HTTPS — required for voice input: browsers only allow the microphone on
# https://. Set a domain that points at this server; with no domain, use the
# free <ip-with-dashes>.sslip.io name (e.g. 3-227-26-8.sslip.io for 3.227.26.8).
# deploy/deploy.sh then gets a Let's Encrypt certificate (ports 80 and 443
# must be open) and the site moves to https://DOMAIN. Leave empty for HTTP.
DOMAIN=
# Optional: expiry warnings from Let's Encrypt go here.
CERT_EMAIL=
# First boot on an empty DB loads the demo seed.
SEED_ON_EMPTY=true

# ── Database / cache (docker-compose overrides the first three for containers) ─
DATABASE_URL=postgresql+asyncpg://agrisense:agrisense@localhost:5432/agrisense
REDIS_URL=redis://localhost:6379/1              # HTTP response cache (DB 1)
CELERY_BROKER_URL=redis://localhost:6379/0      # Celery broker (DB 0)

# ── Auth — REQUIRED in production ─────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string    # openssl rand -hex 32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── Demo / development switches (ignored when ENV=production) ─────────────
# No SMS provider is wired yet. Outside production the server returns each
# random OTP as `dev_otp` and the OTP screen shows it ("Test code: …").
# Leave DEV_FIXED_OTP empty so only that random code works; setting it makes
# every phone accept one fixed code (handy offline, but it is a static OTP).
DEV_FIXED_OTP=
# Enables POST /api/v1/auth/demo-login (one-tap login as the seeded accounts).
DEMO_MODE=true
DEMO_FARMER_PHONE=9822011111
DEMO_BUYER_PHONE=9822022222

# ── CORS: only for browsers calling the API directly (comma-separated) ─────
# The web build normally goes through a same-origin proxy and needs none.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# ── Voice: Sarvam AI (STT /voice/transcribe, TTS /voice/narrate) ──────────
# https://dashboard.sarvam.ai — without it the voice routes return 503 and the
# app falls back to on-device speech.
SARVAM_API_KEY=
SARVAM_ASR_ENDPOINT=https://api.sarvam.ai/speech-to-text
SARVAM_ASR_MODEL=saaras:v3
SARVAM_TTS_ENDPOINT=https://api.sarvam.ai/text-to-speech
SARVAM_NORMALIZE_ENDPOINT=https://api.sarvam.ai/v1/chat/completions
SARVAM_TTS_SPEAKER=shubh
VOICE_CONFIDENCE_THRESHOLD=0.6
VOICE_MAX_RECORDING_SECONDS=10
VOICE_CACHE_ENABLED=true

# ── Agent / LLM / RAG (Track C) — optional; API boots without them ───────
LLM_PROVIDER=gemini                 # gemini | openai | groq
GEMINI_API_KEY=                     # https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=krishi_mitr_kb
EMBEDDING_MODEL=BAAI/bge-m3
AGENT_MEMORY_REDIS_URL=redis://localhost:6379/2   # DB 2 — never DB 1 (cache)

# ── Payments: Razorpay TEST mode (escrow deposit) — optional for the demo ──
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxx

# ── Object storage (lot photos) — MinIO in docker-compose, S3 in prod ─────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=agrisense

# ── Decision-engine tuning (defaults are the validated values) ────────────
# NO_ADVICE_BAND_BPS=3500   MIN_HISTORY_ROWS=180   MIN_GAIN_PAISE=5000
# COMMISSION_RATE_BPS=250   TRANSPORT_PAISE_PER_KM=50

# ── Tier 3 (stretch) ──────────────────────────────────────────────────────
BHASHINI_API_KEY=
BHASHINI_USER_ID=
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
